# The environment of a deployed BI, with placeholder values (S5.8, S5.2). guest-login-check.sh
# and the second run of public-lockdown-check.sh use it. The OAuth provider and FranOps are never
# called: the checks use the API login and anonymous requests only. The image reads the provider's
# endpoints from its discovery document at the first login, so none is set here.
OAUTH_ENABLED=true
OAUTH_ISSUER=https://issuer.invalid
OAUTH_NAME=oidc
OAUTH_CLIENT_ID=check-client
OAUTH_CLIENT_SECRET=check-client-secret
FRANOPS_URL=https://franops.invalid
FRANOPS_BI_API_KEY=fran_check-placeholder-key
EMBEDDED_SUPERSET=true
GUEST_TOKEN_JWT_SECRET=check-guest-secret-not-for-production-0123456789
FRANOPS_ORIGIN=https://franops.invalid
EMBED_ORIGINS=https://portal.invalid
