# The environment of a deployed BI, with placeholder values (S5.8). guest-login-check.sh and
# the second run of public-lockdown-check.sh use it. The OAuth endpoints are never called: the
# checks use the API login and anonymous requests only.
OAUTH_ENABLED=true
OAUTH_ISSUER=https://issuer.invalid
OAUTH_NAME=clerk
OAUTH_CLIENT_ID=check-client
OAUTH_CLIENT_SECRET=check-client-secret
OAUTH_TOKEN_ENDPOINT=https://issuer.invalid/oauth/token
OAUTH_AUTHORIZATION_ENDPOINT=https://issuer.invalid/oauth/authorize
EMBEDDED_SUPERSET=true
GUEST_TOKEN_JWT_SECRET=check-guest-secret-not-for-production-0123456789
FRANOPS_ORIGIN=https://franops.invalid
EMBED_ORIGINS=https://portal.invalid
